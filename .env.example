# ========================================================
# Salla App & Mobile Generator - Environment Configuration
# ========================================================

# 1. Mobile App Cloud Builder (GitHub Actions CI/CD)
# --------------------------------------------------------
# GitHub Personal Access Token (classic with 'repo' scope or fine-grained with Actions + Contents write)
GITHUB_BUILD_TOKEN=ghp_yourPersonalAccessTokenHere

# GitHub repository in format 'owner/repo' where .github/workflows/build-mobile-app.yaml resides
GITHUB_REPO=alielemam2002/salla-app-test

# Secret shared between GitHub Actions worker and your webhook callback (/api/store action: mobile_app_complete)
BUILD_WORKER_SECRET=super_secret_build_worker_key_123

# 2. Database & Multi-Tenant Storage (Upstash Redis / Vercel KV)
# --------------------------------------------------------
# Required for persisting merchant mobile app configs, build history, and push tokens
KV_REST_API_URL=https://your-upstash-instance.upstash.io
KV_REST_API_TOKEN=your_upstash_rest_token_here

# 3. Salla Partner & App Credentials (Salla Developer Portal)
# --------------------------------------------------------
SALLA_APP_ID=your_salla_app_id
SALLA_CLIENT_ID=your_salla_client_id
SALLA_CLIENT_SECRET=your_salla_client_secret
SALLA_WEBHOOK_SECRET=your_salla_webhook_secret

# 4. AI Copilot (Gemini API)
# --------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# 5. System Cron Secret
# --------------------------------------------------------
CRON_SECRET=your_internal_cron_secret
